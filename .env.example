APP_NAME=Payment Workflow API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
DATABASE_URL=mysql+asyncmy://root:your_password@localhost:3306/payment_workflow?charset=utf8mb4
VAULT_DATABASE_URL=mysql+asyncmy://root:your_password@localhost:3306/payment_vault?charset=utf8mb4
# Docker containers reach a MySQL instance on the host through this name.
DATABASE_URL_DOCKER=mysql+asyncmy://root:your_password@host.docker.internal:3306/payment_workflow?charset=utf8mb4
VAULT_DATABASE_URL_DOCKER=mysql+asyncmy://root:your_password@host.docker.internal:3306/payment_vault?charset=utf8mb4
JWT_SECRET_KEY=replace-with-a-random-64-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CARD_VAULT_ENCRYPTION_KEY=replace-with-your-card-vault-key
MERCHANT_VAULT_ENCRYPTION_KEY=replace-with-your-merchant-vault-key
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
# Optional: only required when running the opt-in load-tester Compose profile.
LOAD_TEST_ACCESS_TOKEN=
